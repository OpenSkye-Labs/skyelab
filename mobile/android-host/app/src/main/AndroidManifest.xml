<?xml version="1.0" encoding="utf-8"?>
<!-- One permission, one activity, no deep links: mobile/scripts/check-hosts.sh enforces it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sockets to the desktop. Nothing reads network state, so no ACCESS_NETWORK_STATE. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- From gpui-mobile's example manifest: wgpu falls back to GLES 3 where Vulkan is missing. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/SkyeLabTheme">

        <!-- singleTask: the Rust side starts once per process (android_main), so never stack a second instance.
             An empty taskAffinity keeps other apps' tasks from claiming it (task hijacking before Android 11). -->
        <activity
            android:name=".SkyeLabActivity"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- NativeActivity loads lib<value>.so; the cdylib in mobile/android. -->
            <meta-data android:name="android.app.lib_name" android:value="skyelab_mobile_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
