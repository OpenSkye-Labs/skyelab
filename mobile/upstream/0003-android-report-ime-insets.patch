+/// Overwrite the content-rect safe area with the window's real insets when
+/// `WindowInsets` can say (API 30+), keyboard included.
+fn refresh_insets(win: &super::window::AndroidWindow) {
+    match window_insets() {
+        Ok((bars, ime_bottom)) => {
+            log::info!("window insets: bars={bars:?} ime_bottom={ime_bottom} (physical px)");
+            win.update_insets(bars, ime_bottom);
+        }
+        Err(e) => log::debug!("WindowInsets unavailable, keeping the content rect: {e}"),
+    }
+}
+
+/// The decor view's root `WindowInsets` in physical pixels: the system bars
+/// plus display cutout as `[left, top, right, bottom]`, and the keyboard's
+/// bottom inset. `Err` below API 30 or before the view is attached.
+fn window_insets() -> Result<([i32; 4], i32), String> {
+    with_env(|env| {
+        let activity = activity(env)?;
+        let result = env.with_local_frame(8, |env| -> jni::errors::Result<Option<([i32; 4], i32)>> {
+            let window = env
+                .call_method(
+                    &activity,
+                    jni::jni_str!("getWindow"),
+                    jni::jni_sig!("()Landroid/view/Window;"),
+                    &[],
+                )?
+                .l()?;
+            let decor = env
+                .call_method(
+                    &window,
+                    jni::jni_str!("getDecorView"),
+                    jni::jni_sig!("()Landroid/view/View;"),
+                    &[],
+                )?
+                .l()?;
+            let insets = env
+                .call_method(
+                    &decor,
+                    jni::jni_str!("getRootWindowInsets"),
+                    jni::jni_sig!("()Landroid/view/WindowInsets;"),
+                    &[],
+                )?
+                .l()?;
+            if insets.is_null() {
+                return Ok(None);
+            }
+            let mut type_mask = |name| -> jni::errors::Result<i32> {
+                env.call_static_method(
+                    jni::jni_str!("android/view/WindowInsets$Type"),
+                    name,
+                    jni::jni_sig!("()I"),
+                    &[],
+                )?
+                .i()
+            };
+            let bars_mask =
+                type_mask(jni::jni_str!("systemBars"))? | type_mask(jni::jni_str!("displayCutout"))?;
+            let ime_mask = type_mask(jni::jni_str!("ime"))?;
+            let mut edges = |mask: i32| -> jni::errors::Result<[i32; 4]> {
+                let edges = env
+                    .call_method(
+                        &insets,
+                        jni::jni_str!("getInsets"),
+                        jni::jni_sig!("(I)Landroid/graphics/Insets;"),
+                        &[JValue::Int(mask)],
+                    )?
+                    .l()?;
+                let mut field = |name| -> jni::errors::Result<i32> {
+                    env.get_field(&edges, name, jni::jni_sig!("I"))?.i()
+                };
+                Ok([
+                    field(jni::jni_str!("left"))?,
+                    field(jni::jni_str!("top"))?,
+                    field(jni::jni_str!("right"))?,
+                    field(jni::jni_str!("bottom"))?,
+                ])
+            };
+            let bars = edges(bars_mask)?;
+            let ime = edges(ime_mask)?;
+            Ok(Some((bars, ime[3])))
+        });
+        if result.is_err() {
+            env.exception_clear();
+        }
+        result.e()?.ok_or_else(|| "the decor view has no insets yet".to_string())
+    })
+}
