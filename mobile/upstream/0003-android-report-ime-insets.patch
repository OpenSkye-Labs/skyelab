+    /// Replace the content-rect estimate with the window's own insets, in
+    /// physical pixels: `bars` (left, top, right, bottom) from
+    /// `systemBars() | displayCutout()`, `ime_bottom` from `ime()`.
+    ///
+    /// The content rect only shrinks for the keyboard while the system still
+    /// resizes for it (`adjustResize` below target SDK 35); `WindowInsets`
+    /// reports it either way, and separately from the navigation bar.
+    pub fn update_insets(&self, bars: [i32; 4], ime_bottom: i32) {
+        let mut state = self.state.lock();
+        let [left, top, right, bottom] = bars.map(|v| v.max(0) as f32);
+        state.safe_area_insets = SafeAreaInsets {
+            top,
+            bottom,
+            left,
+            right,
+        };
+        state.ime_bottom = ime_bottom.max(0) as f32;
+    }
+
+    /// The keyboard's height over the bottom edge, in logical pixels.
+    pub fn ime_bottom_logical(&self) -> f32 {
+        let state = self.state.lock();
+        state.ime_bottom / state.scale_factor
+    }
